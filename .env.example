# Copy to .env and adjust only local paths or deliberate profile overrides.
# .env is ignored by Git. Model weights remain outside the repository.

MODEL_DIR=C:/path/to/models
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_S.gguf
MODEL_ALIAS=qwen36-35b-a3b

# CUDA 12 server image validated with the deployment check.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:1f4b9cf58982dd4d7cc497aea31b1a456ca9a3a1f94f527d317d3fdee0d60ab6
LLAMA_HOST_PORT=8089

# Worker defaults: bounded context and one request at a time.
LLAMA_CTX_SIZE=16384
LLAMA_GPU_LAYERS=99
LLAMA_CACHE_TYPE_K=q4_0
LLAMA_CACHE_TYPE_V=q4_0
LLAMA_BATCH_SIZE=1024
LLAMA_UBATCH_SIZE=512
LLAMA_THREADS=12
LLAMA_REASONING_BUDGET=1536
